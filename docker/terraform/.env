# .terraform (プロバイダ等) の出力先を /workspace の外にする
TF_DATA_DIR=/state/.terraform

# tfstate の出力先 (backend "local" の path) を init 時に渡す
TF_CLI_ARGS_init=-backend-config=env/docker/backend.hcl

# 環境固有の変数ファイル (init 以外のコマンドに渡す)
TF_CLI_ARGS_plan=-var-file=env/docker/terraform.tfvars
TF_CLI_ARGS_apply=-var-file=env/docker/terraform.tfvars
TF_CLI_ARGS_destroy=-var-file=env/docker/terraform.tfvars
